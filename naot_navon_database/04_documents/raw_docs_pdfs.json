### Ran Playwright code
```js
await (async (page) => {
  // Extract all document links from documents section
  const docs = await page.evaluate(() => {
    const docSection = document.getElementById('documents');
    if (!docSection) return [];
    const links = Array.from(docSection.querySelectorAll('a[href]'));
    return links.map(a => ({
      text: a.innerText.trim(),
      href: a.href,
      decoded: decodeURIComponent(a.href)
    }));
  });
  
  // All PDF links categorized
  const allPdfs = await page.evaluate(() => {
    const links = Array.from(document.querySelectorAll('a[href*=".pdf"]'));
    const unique = new Map();
    links.forEach(a => {
      if (!unique.has(a.href)) {
        const url = decodeURIComponent(a.href);
        let category = 'other';
        if (url.includes('/קומות/')) category = 'floor_plan';
        else if (url.includes('/דירות/')) category = 'apartment_plan';
        else if (url.includes('חניון') || url.includes('parking')) category = 'parking';
        else if (url.includes('מחסנ')) category = 'storage';
        else if (url.includes('פיתוח')) category = 'development';
        const buildingMatch = url.match(/data\/(\d+)\//);
        unique.set(a.href, {
          href: a.href,
          decoded: url,
          category,
          building: buildingMatch ? buildingMatch[1] : null,
          text: a.innerText.trim() || a.title || ''
        });
      }
    });
    return Array.from(unique.values());
  });
  
  // All images
  const images = await page.evaluate(() => {
    return Array.from(document.querySelectorAll('img[src]')).map(img => ({
      src: img.src,
      alt: img.alt || '',
      width: img.naturalWidth,
      height: img.naturalHeight
    }));
  });
  
  return { docs, pdfCount: allPdfs.length, pdfs: allPdfs, imageCount: images.length, images };
})(page);
