await (async (page) => {
  // Extract price list table data
  const priceData = await page.evaluate(() => {
    const tables = document.querySelectorAll('table');
    const result = [];
    tables.forEach((table, idx) => {
      const headers = Array.from(table.querySelectorAll('th')).map(th => th.innerText.trim());
      const rows = Array.from(table.querySelectorAll('tbody tr, tr')).map(tr => {
        return Array.from(tr.querySelectorAll('td, th')).map(td => td.innerText.trim());
      });
      result.push({ tableIndex: idx, headers, rows, parentId: table.closest('[id]')?.id || null });
    });
    return result;
  });
  return priceData;
})(page);
